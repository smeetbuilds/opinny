{
  "name": "opinny",
  "version": "0.1.0",
  "description": "Open-source, backend-agnostic crypto prediction-market frontend built with Next.js and Bun.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Aahav Labs",
    "email": "hi@aahavlabs.in",
    "url": "https://aahavlabs.in"
  },
  "homepage": "https://aahavlabs.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/smeetbuilds/opinny.git"
  },
  "bugs": {
    "url": "https://github.com/smeetbuilds/opinny/issues"
  },
  "keywords": [
    "prediction-market",
    "crypto",
    "nextjs",
    "bun",
    "frontend",
    "open-source",
    "web3"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
